# Razer Barracuda X 2.4 GHz dongle battery query — HID vendor feature reports
# on the hidraw node. uaccess grants the active local seat user read/write via
# logind ACLs, so no openrazer / plugdev setup is needed.
#   barracuda_battery.py: VID 0x1532, PIDs 0536 / 0552 / 0574
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1532", ATTRS{idProduct}=="0536", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1532", ATTRS{idProduct}=="0552", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1532", ATTRS{idProduct}=="0574", TAG+="uaccess"