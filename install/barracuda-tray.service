[Unit]
Description=Barracuda headset battery tray icon
Comment=StatusNotifierItem tray icon + low-battery notifications for the Razer Barracuda (X family / Pro 2.4)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/barracuda-tray
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target