#!/usr/bin/env python3
"""Tiny live battery watch for the Razer Barracuda (X / Pro). Usage: barracuda-watch [interval_sec]"""
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from barracuda_battery import device_name, read_state

CLEAR, RESET, DIM = "\x1b[2J\x1b[H", "\x1b[0m", "\x1b[2m"
DEFAULT_NAME = "Razer Barracuda"


def color(p):
    return "\x1b[32m" if p >= 50 else "\x1b[33m" if p > 20 else "\x1b[31m"


def bar(p, w=25):
    n = round(p / 100 * w)
    return "█" * n + "░" * (w - n)


def main():
    interval = float(sys.argv[1]) if len(sys.argv) > 1 else 5.0
    sys.stdout.reconfigure(line_buffering=True)
    print("starting…")
    first = True
    name = DEFAULT_NAME
    try:
        while True:
            if not first:
                print(CLEAR, end="")
            first = False
            state, err = None, None
            try:
                state = read_state()
            except (OSError, ValueError, FileNotFoundError) as e:
                err = e
            if state:
                name = "Razer " + device_name(state.get("pid"))
            print(f"{name} — {time.strftime('%H:%M:%S')}  "
                  f"(poll {interval:g} s, Ctrl-C to quit)")
            if state:
                mv = state['millivolts']
                mv_txt = f"  \x1b[36m{mv} mV\x1b[0m" if mv is not None else ""
                link = state.get('link')
                link_txt = f"  signal {link}" if link is not None else ""
                print(f"\n  {color(state['percent'])}{state['percent']:3d} %{RESET}  "
                      f"{bar(state['percent'])}{mv_txt}{link_txt}  {state['status']}\n")
                print(f"  {DIM}{state['device']} · raw: {state['raw']}{RESET}")
            else:
                print(f"\n  waiting for dongle… ({err})")
            time.sleep(interval)
    except KeyboardInterrupt:
        print(f"{RESET}\nbye")


if __name__ == "__main__":
    main()